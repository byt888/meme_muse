# 复制为 .env 后填写真实值, 绝不提交到 git
# cp .env.example .env && chmod 600 .env

# GMGN Agent API Key (https://gmgn.ai/ai 页面生成, Free 套餐先用)
GMGN_API_KEY=
# GMGN 交易签名密钥 (API 请求签名用, 非链上钱包私钥; 可随时在后台轮换)
GMGN_PRIVATE_KEY=
# 无头自动交易总开关 (需用户明确授权后才设为 1)
GMGN_ALLOW_AUTOMATED_TRADES=0

# J7Tracker sessionId (JWT, 15天有效期, j7tracker.io 登录后 F12 获取)
J7_SESSION_ID=

# Telegram (待接入)
TG_API_ID=
TG_API_HASH=

# B轨自持钱包 (待用户授权创建后填写, 建议只放小额)
BSC_WALLET_ADDRESS=
BSC_WALLET_PRIVATE_KEY=
